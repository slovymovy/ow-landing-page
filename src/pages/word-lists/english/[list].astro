---
import WordListPage from '../../../components/pages/WordListPage.astro';
import { orderedSlugs } from '../../../data/wordLists';

export function getStaticPaths() {
  return orderedSlugs().map((list) => ({ params: { list } }));
}

const list = Astro.params.list as string;
---
<WordListPage locale="en" slug={list} />
