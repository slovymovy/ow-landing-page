řekládat, přeložit","tr":"çevirmek, tercüme etmek","es":"traducir, trasladar"}},{"w":"revise","d":"To study information again, especially to prepare for an exam.","t":{"ru":"повторять, готовиться","nl":"herhalen, studeren","pl":"powtarzać, przygotowywać się","de":"wiederholen, repetieren, rekapitulieren","fr":"réviser, repasser","it":"ripassare, prepararsi","cs":"opakovat, připravovat se","tr":"tekrar etmek, çalışmak","es":"repasar, estudiar"}},{"w":"memorize","d":"To fully learn something so that it is stored in the memory; to learn by heart.","t":{"ru":"запомина́ть, запо́мнить, зау́чивать наизу́сть, вы́учить","nl":"uit het hoofd leren, memoriseren","pl":"zapamiętywać, zapamiętać, nauczyć się na pamięć","de":"auswendig lernen, sich einprägen, sich merken","fr":"mémoriser, apprendre par cœur","it":"memorizzare, imparare a memoria","cs":"učit se nazpaměť, memorovat, nabiflovat se","tr":"ezberlemek, bellemek","es":"memorizar, aprender de memoria"}},{"w":"cheat","d":"To violate rules in order to gain, or attempt to gain, an unfair advantage in a situation.","t":{"ru":"списывать, жульничать, мухлевать, мошенничать","nl":"valsspelen, spieken, bedriegen","pl":"oszukiwać, ściągać, szulerować","de":"schummeln, mogeln, spicken, betrügen","fr":"tricher, frauder","it":"barare, imbrogliare, copiare","cs":"podvádět, opisovat, švindlovat","tr":"hile yapmak, kopya çekmek, sahtekarlık yapmak","es":"hacer trampa, copiar, trampear"}},{"w":"skip","d":"To choose not to attend a specific event, such as a class or meeting.","t":{"ru":"пропускать, прогуливать","nl":"overslaan, spijbelen","pl":"opuścić, wagarować","de":"schwänzen, verpassen, blaumachen","fr":"manquer, sécher","it":"saltare, bigiare","cs":"vynechat, záškoláctví","tr":"asmak, katılmamak","es":"faltar, saltarse, hacer novillos"}},{"w":"pass","d":"To be successful in an examination, test, or inspection.","t":{"ru":"сдать, пройти","nl":"slagen, halen","pl":"zdać, zdawać, przejść","de":"bestehen","fr":"réussir, passer","it":"superare, passare","cs":"udělat, složit, projít","tr":"geçmek, başarmak","es":"aprobar, pasar"}},{"w":"fail","d":"To not pass a test, exam, or course.","t":{"ru":"провалить, не сдать, завалить","nl":"zakken, buizen, falen","pl":"oblać, nie zdać, zawalić","de":"durchfallen, nicht bestehen","fr":"échouer, rater","it":"essere bocciato, fallire, cannare","cs":"neudělat, propadnout, pohořet","tr":"kalmak, başarısız olmak, sınıfta kalmak","es":"reprobar, suspender, no aprobar"}},{"w":"graduate","d":"To successfully complete an academic degree, course of training, or high school education.","t":{"ru":"оканчивать, выпускаться","nl":"afstuderen","pl":"ukończyć, skończyć","de":"absolvieren, den Abschluss machen","fr":"obtenir son diplôme, être diplômé","it":"laurearsi, diplomarsi","cs":"absolvovat, promovat, vystudovat","tr":"mezun olmak","es":"graduarse, terminar"}},{"w":"difficult","d":"Not easy to do, understand, or deal with; requiring much effort or skill.","t":{"ru":"трудный, сложный, тяжёлый","nl":"moeilijk, lastig, zwaar","pl":"trudny, skomplikowany, ciężki","de":"schwierig, schwer, kompliziert","fr":"difficile, dur, complexe","it":"difficile, complicato","cs":"těžký, obtížný, složitý","tr":"zor, güç, çetin","es":"difícil, complicado, duro"}},{"w":"easy","d":"Requiring little skill, effort, or thought; not difficult.","t":{"ru":"лёгкий, простой, нетрудный","nl":"makkelijk, gemakkelijk, eenvoudig","pl":"łatwy, prosty, lekki","de":"leicht, einfach","fr":"facile, simple, aisé","it":"facile, semplice","cs":"snadný, lehký, jednoduchý","tr":"kolay, basit","es":"fácil, sencillo"}},{"w":"absent","d":"Not present in a place where one is expected to be.","t":{"ru":"отсутствующий, не присутствующий","nl":"afwezig","pl":"nieobecny","de":"abwesend","fr":"absent","it":"assente","cs":"nepřítomný","tr":"devamsız, yok","es":"ausente"}},{"w":"correct","d":"Free from error; true; accurate.","t":{"ru":"правильный, верный","nl":"correct, juist, goed","pl":"poprawny, prawidłowy, właściwy","de":"richtig, korrekt","fr":"correct, exact, juste","it":"corretto, esatto, giusto","cs":"správný, přesný","tr":"doğru","es":"correcto, exacto"}},{"w":"wrong","d":"Incorrect or untrue; not agreeing with facts or reality.","t":{"ru":"неправильный, неверный, ошибочный","nl":"fout, verkeerd, onjuist","pl":"błędny, nieprawidłowy, zły, mylny","de":"falsch, verkehrt, falschliegen","fr":"incorrect, faux, erroné","it":"sbagliato, errato, erroneo","cs":"špatný, nesprávný, chybný","tr":"yanlış, hatalı","es":"incorrecto, equivocado, erróneo, falso"}},{"w":"strict","d":"Expecting people to obey rules or to do exactly what you say.","t":{"ru":"строгий, требовательный, суровый","nl":"streng","pl":"surowy, srogi, wymagający","de":"streng","fr":"strict, sévère, exigeant","it":"severo, rigido","cs":"přísný","tr":"katı, disiplinli, sert","es":"estricto, riguroso, exigente"}},{"w":"clever","d":"Quick to understand, learn, and devise or apply ideas; intelligent.","t":{"ru":"умный, сообразительный, способный","nl":"slim, scherpzinnig","pl":"bystry, zdolny, sprytny","de":"klug, gescheit, clever","fr":"intelligent, vif, brillant","it":"intelligente, sveglio, brillante","cs":"chytrý, bystrý","tr":"zeki, akıllı, kavrayışlı","es":"inteligente, listo, avispado"}},{"w":"lazy","d":"Unwilling to do work or make an effort.","t":{"ru":"ленивый","nl":"lui, werkschuw","pl":"leniwy","de":"faul","fr":"paresseux, fainéant","it":"pigro, ozioso","cs":"líný","tr":"tembel, üşengeç","es":"perezoso, vago, holgazán"}},{"w":"bored","d":"Feeling tired, unhappy, or restless because one has lost interest or has nothing to do.","t":{"ru":"скучающий, скучно","nl":"verveeld","pl":"znudzony, nudzić się","de":"gelangweilt","fr":"ennuyé","it":"annoiato, scocciato","cs":"znuděný, nudit se","tr":"sıkılmış, sıkılan","es":"aburrido"}},{"w":"confused","d":"Unable to think clearly or understand what is happening or what is being said.","t":{"ru":"растерянный, сбитый с толку, запутанный","nl":"verward, in de war","pl":"zmieszany, zakłopotany, zdezorientowany","de":"verwirrt, durcheinander, konfus","fr":"perdu, désorienté, embarrassé","it":"confuso, disorientato","cs":"zmatený, rozpačitý","tr":"kafası karışmış, şaşkın","es":"confundido, desconcertado"}},{"w":"nervous","d":"Feeling worry, fear, or anxiety about something that might happen.","t":{"ru":"взволнованный, нервный","nl":"nerveus, gespannen, zenuwachtig","pl":"zdenerwowany, nerwowy, zaniepokojony","de":"nervös, aufgeregt","fr":"nerveux, anxieux, inquiet","it":"nervoso, agitato","cs":"nervózní, nesvůj","tr":"gergin, endişeli, heyecanlı","es":"nervioso"}},{"w":"stressed","d":"Suffering from mental, emotional, or physical tension.","t":{"ru":"напряжённый, в состоянии стресса","nl":"gestrest, overspannen","pl":"zestresowany, napięty","de":"gestresst, strapaziert","fr":"stressé","it":"stressato, sotto stress","cs":"ve stresu, vypjatý, vystresovaný","tr":"stresli, yıpranmış","es":"estresado"}}]