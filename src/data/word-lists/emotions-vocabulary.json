,"c":{"ru":"существительное","nl":"zelfstandig naamwoord","pl":"rzeczownik","de":"Substantiv","fr":"nom","it":"sostantivo","cs":"podstatné jméno","tr":"isim","es":"sustantivo"}},{"w":"laughter","d":"The action or sound of laughing, usually expressing happiness or amusement.","t":{"ru":"смех, хохот","nl":"gelach, lachen","pl":"śmiech, chichot, śmiechy","de":"Lachen, Gelächter","fr":"rire, éclat de rire","it":"risata, riso","cs":"smích, řehot","tr":"gülüş, kahkaha","es":"risa, carcajada"}},{"w":"tear","d":"A drop of clear, salty liquid produced from the eyes by crying or irritation.","t":{"ru":"слеза","nl":"traan","pl":"łza","de":"Träne","fr":"larme","it":"lacrima","cs":"slza","tr":"gözyaşı","es":"lágrima"}},{"w":"mind","d":"The part of a person that enables them to think, reason, feel emotions, and be aware of things.","t":{"ru":"ум, интеллект, рассудок","nl":"geest, verstand, psyche, denkvermogen","pl":"umysł, rozum, um","de":"Verstand, Geist, Bewusstsein, Psyche","fr":"esprit, intelligence","it":"mente, cervello","cs":"mysl, rozum","tr":"zihin, akıl","es":"mente, intelecto"}},{"w":"brain","d":"The organ inside the head that controls thought, memory, feelings, and activity.","t":{"ru":"мозг, головно́й мозг","nl":"hersenen, brein","pl":"mózg","de":"Gehirn, Hirn","fr":"cerveau, encéphale","it":"cervello, encefalo","cs":"mozek","tr":"beyin","es":"cerebro, encéfalo"}},{"w":"memory","d":"A specific thought, image, or experience from the past that a person remembers.","t":{"ru":"воспоминание","nl":"herinnering","pl":"wspomnienie","de":"Erinnerung","fr":"souvenir","it":"ricordo, memoria","cs":"vzpomínka","tr":"anı, hatıra","es":"recuerdo"}},{"w":"thought","d":"An idea, opinion, or piece of information produced by thinking, or occurring suddenly in the mind.","t":{"ru":"мысль, идея","nl":"gedachte, idee","pl":"myśl, pomysł","de":"Gedanke, Idee","fr":"pensée, idée","it":"pensiero, idea","cs":"myšlenka, nápad","tr":"düşünce, fikir","es":"pensamiento, idea"}},{"w":"attention","d":"The act or power of carefully thinking about, listening to, or watching someone or something.","t":{"ru":"внимание, внимательность","nl":"aandacht, attentie","pl":"uwaga, skupienie","de":"Aufmerksamkeit, Beachtung","fr":"attention, vigilance","it":"attenzione","cs":"pozornost","tr":"dikkat, ilgi, özen","es":"atención, concentración"}},{"w":"motivation","d":"The desire or willingness to do something; enthusiasm.","t":{"ru":"мотивация, стремление, энтузиазм","nl":"motivatie, gedrevenheid","pl":"motywacja, zapał, chęć","de":"Motivation, Leistungsbereitschaft","fr":"motivation, enthousiasme, détermination","it":"motivazione, entusiasmo, determinazione","cs":"motivace, nadšení, odhodlání","tr":"motivasyon, güdü, istek","es":"motivación, entusiasmo, ganas"}},{"w":"personality","d":"The combination of characteristics or qualities that form an individual's distinctive character.","t":{"ru":"личность, характер, индивидуальность","nl":"persoonlijkheid, karakter","pl":"osobowość, charakter","de":"Persönlichkeit, Charakter","fr":"personnalité, caractère","it":"personalità, carattere","cs":"osobnost, povaha","tr":"kişilik, şahsiyet","es":"personalidad, carácter"}},{"w":"behavior","d":"The way a living creature behaves or acts generally.","t":{"ru":"поведение","nl":"gedrag","pl":"zachowanie","de":"Verhalten, Verhaltensweise","fr":"comportement, conduite","it":"comportamento","cs":"chování, jednání","tr":"davranış, tutum","es":"comportamiento, conducta"}},{"w":"depression","d":"A medical condition or state of mind characterized by severe, long-term unhappiness, low morale, and a lack of interest in life.","t":{"ru":"депрессия, уныние, подавленность","nl":"depressie, neerslachtigheid","pl":"depresja, przygnębienie","de":"Depression, Niedergeschlagenheit","fr":"dépression, déprime","it":"depressione, abbattimento","cs":"deprese, sklíčenost","tr":"depresyon, bunalım","es":"depresión"}},{"w":"trauma","d":"An emotional or psychological wound caused by a deeply distressing or disturbing experience.","t":{"ru":"травма, рана","nl":"trauma","pl":"trauma, uraz psychiczny","de":"Trauma","fr":"traumatisme, choc émotionnel","it":"trauma, ferita emotiva","cs":"trauma","tr":"travma","es":"trauma"}},{"w":"burnout","d":"The experience of long-term exhaustion and diminished interest, especially in one's career.","t":{"ru":"выгорание, эмоциональное выгорание","nl":"burn-out","pl":"wypalenie, wypalenie zawodowe","de":"Burn-out, Ausgebranntsein","fr":"burn-out, syndrome d’épuisement professionnel, surmenage","it":"burnout, esaurimento nervoso, sindrome da burnout","cs":"vyhoření, syndrom vyhoření","tr":"tükenmişlik, mesleki tükenmişlik","es":"agotamiento, burnout, síndrome de desgaste profesional"}},{"w":"therapy","d":"Psychotherapy; the treatment of mental or psychological disorders.","t":{"ru":"терапия, психотерапия","nl":"therapie, psychotherapie","pl":"terapia, psychoterapia","de":"Therapie, Psychotherapie","fr":"thérapie, psychothérapie","it":"psicoterapia, terapia","cs":"terapie, psychoterapie","tr":"terapi, psikoterapi","es":"terapia, psicoterapia"}},{"w":"happy","d":"Feeling or showing pleasure, contentment, or joy.","t":{"ru":"счастливый, радостный, довольный","nl":"gelukkig, blij, tevreden","pl":"szczęśliwy, radosny, zadowolony","de":"glücklich, fröhlich, froh, zufrieden","fr":"heureux, content, joyeux","it":"felice, contento, lieto","cs":"šťastný, veselý, radostný, spokojený","tr":"mutlu, memnun, neşeli","es":"feliz, alegre, contento"}},{"w":"glad","d":"Feeling pleasure, joy, or delight.","t":{"ru":"рад, довольный","nl":"blij, verheugd","pl":"zadowolony, rad, szczęśliwy, uradowany","de":"froh, glücklich, erfreut","fr":"content, heureux, ravi","it":"felice, contento, lieto","cs":"rád, potěšený","tr":"memnun, mutlu, sevinçli","es":"contento, alegre, gustoso"}},{"w":"cheerful","d":"Noticeably happy, optimistic, and in good spirits.","t":{"ru":"весёлый, жизнерадостный, бодрый","nl":"vrolijk, opgewekt, blijmoedig","pl":"wesoły, pogodny, radosny","de":"fröhlich, vergnügt","fr":"joyeux, de bonne humeur, enjoué","it":"allegro, felice, gioioso","cs":"veselý, radostný, pohodový","tr":"neşeli, keyifli, hayat dolu","es":"alegre, animado, risueño"}},{"w":"sad","d":"Feeling sorrow, unhappiness, or grief.","t":{"ru":"грустный, печальный","nl":"verdrietig, triest","pl":"smutny, przygnębiony","de":"traurig, betrübt","fr":"triste, affligé","it":"triste, addolorato","cs":"smutný, nešťastný","tr":"üzgün, mutsuz, mahzun","es":"triste, apenado"}},{"w":"angry","d":"Feeling or showing strong annoyance, displeasure, or hostility.","t":{"ru":"сердитый, злой, рассерженный","nl":"boos, kwaad, woedend","pl":"zły, rozgniewany, wściekły","de":"wütend, verärgert, böse, zornig","fr":"en colère, fâché, furieux, énervé","it":"arrabbiato, adirato, furioso","cs":"rozzlobený, naštvaný, rozhněvaný, zlostný","tr":"kızgın, öfkeli, sinirli","es":"enojado, enfadado, furioso"}},{"w":"annoyed","d":"Troubled or irritated by something unwanted or unliked.","t":{"ru":"раздражённый, раздосадованный, сердитый","nl":"geïrriteerd, geërgerd","pl":"zirytowany, poirytowany, rozdrażniony","de":"verärgert, genervt, ärgerlich, sauer","fr":"contrarié, fâché, vexé, agacé","it":"irritato, infastidito, seccato","cs":"podrážděný, naštvaný, otrávený","tr":"rahatsız olmuş, kızgın, sinirli","es":"irritado, molesto, enfadado"}},{"w":"tired","d":"In need of some rest or sleep.","t":{"ru":"усталый, уставший, утомлённый","nl":"moe, vermoeid","pl":"zmęczony, znużony","de":"müde, erschöpft","fr":"fatigué","it":"stanco, esausto, affaticato, distrutto","cs":"unavený, utahaný","tr":"yorgun, bitkin","es":"cansado, fatigado"}},{"w":"calm","d":"Peaceful, quiet, and free from anger, anxiety, or stress.","t":{"ru":"спокойный, тихий","nl":"kalm, rustig, vredig","pl":"spokojny, opanowany, cichy","de":"ruhig, gelassen","fr":"calme, tranquille","it":"calmo, tranquillo","cs":"klidný, tichý","tr":"sakin, dingin","es":"tranquilo, calmado, sereno"}},{"w":"relaxed","d":"Free from tension or anxiety; at ease; leisurely.","t":{"ru":"расслабленный, непринужденный, спокойный","nl":"ontspannen, rustig, kalm","pl":"zrelaksowany, rozluźniony, swobodny","de":"entspannt, locker","fr":"détendu, décontracté","it":"rilassato, disteso, tranquillo","cs":"uvolněný, pohodový, klidný","tr":"rahat, gevşek, huzurlu","es":"relajado, tranquilo"}},{"w":"nervous","d":"Feeling worry, fear, or anxiety about something that might happen.","t":{"ru":"взволнованный, нервный","nl":"nerveus, gespannen, zenuwachtig","pl":"zdenerwowany, nerwowy, zaniepokojony","de":"nervös, aufgeregt","fr":"nerveux, anxieux, inquiet","it":"nervoso, agitato","cs":"nervózní, nesvůj","tr":"gergin, endişeli, heyecanlı","es":"nervioso"}},{"w":"anxious","d":"Feeling nervous, worried, or uneasy about something.","t":{"ru":"беспокоящийся, встревоженный, тревожный","nl":"bezorgd, nerveus","pl":"zaniepokojony, zdenerwowany, pełen obaw","de":"besorgt, nervös, ängstlich","fr":"inquiet, nerveux","it":"ansioso, inquieto, preoccupato","cs":"úzkostný, nervózní, znepokojený","tr":"endişeli, kaygılı, tedirgin","es":"ansioso, preocupado, nervioso"}},{"w":"worried","d":"Feeling or showing fear and concern because you think that something bad has happened or could happen.","t":{"ru":"обеспокоенный, встревоженный, озабоченный","nl":"bezorgd, ongerust","pl":"zmartwiony, zaniepokojony, zatroskany","de":"besorgt, beunruhigt","fr":"inquiet, soucieux","it":"preoccupato, in ansia, turbato","cs":"znepokojený, ustaraný, nervózní","tr":"endişeli, kaygılı, tasalı","es":"preocupado, desasosegado"}},{"w":"stressed","d":"Suffering from mental, emotional, or physical tension.","t":{"ru":"напряжённый, в состоянии стресса","nl":"gestrest, overspannen","pl":"zestresowany, napięty","de":"gestresst, strapaziert","fr":"stressé","it":"stressato, sotto stress","cs":"ve stresu, vypjatý, vystresovaný","tr":"stresli, yıpranmış","es":"estresado"}},{"w":"scared","d":"Feeling fear; afraid, frightened.","t":{"ru":"испуганный, напуганный, боящийся","nl":"bang, beangstigd, geschrokken","pl":"wystraszony, przestraszony, bojący się","de":"ängstlich, Angst haben, erschrocken, verängstigt","fr":"effrayé, avoir peur, apeuré","it":"spaventato, impaurito, avere paura","cs":"vystrašený, vyděšený, mít strach","tr":"korkmuş, ürkmüş, korkuyor","es":"asustado, tener miedo, atemorizado"}},{"w":"afraid","d":"Feeling fear or apprehension; frightened.","t":{"ru":"бояться, испуганный","nl":"bang, bevreesd, angstig","pl":"bać się, przestraszony, wystraszony","de":"ängstlich, furchtsam, Angst haben","fr":"avoir peur, effrayé, craintif","it":"spaventato, impaurito, avere paura","cs":"bát se, vystrašený, bázlivý","tr":"korkmuş, korkmak","es":"asustado, tener miedo, temeroso"}},{"w":"surprised","d":"Caused to feel surprise, amazement or wonder, or showing an emotion due to an unexpected event.","t":{"ru":"удивлённый, изумлённый","nl":"verbaasd, verrast","pl":"zaskoczony, zdziwiony","de":"überrascht, erstaunt","fr":"surpris, étonné","it":"sorpreso, stupito, meravigliato","cs":"překvapený, udivený, zaskočený","tr":"şaşkın, hayret etmiş","es":"sorprendido, asombrado, estupefacto"}},{"w":"excited","d":"Having great enthusiasm, passion, and energy.","t":{"ru":"взволнованный, в восторге, радостный, взбудораженный","nl":"opgewonden, opgetogen, enthousiast","pl":"podekscytowany, zachwycony, pełen entuzjazmu","de":"aufgeregt, begeistert","fr":"enthousiaste, impatient, excité","it":"entusiasta, eccitato","cs":"nadšený, vzrušený","tr":"heyecanlı, hevesli","es":"entusiasmado, emocionado"}},{"w":"upset","d":"Angry, distressed, or unhappy.","t":{"ru":"расстроенный, огорчённый, рассерженный","nl":"overstuur, ontdaan, geschokt","pl":"zmartwiony, przygnębiony, zaniepokojony","de":"aufgebracht, aufgewühlt","fr":"bouleversé, contrarié, fâché","it":"sconvolto, turbato","cs":"rozrušený, rozladěný, smutný","tr":"üzgün, kızgın, morali bozuk","es":"disgustado, enfadado, apenado"},"c":{"ru":"прилагательное","nl":"bijvoeglijk naamwoord","pl":"przymiotnik","de":"Adjektiv","fr":"adjectif","it":"aggettivo","cs":"přídavné jméno","tr":"sıfat","es":"adjetivo"}},{"w":"disappointed","d":"Feeling sad, unhappy, or displeased because something was not as good as expected or because something did not happen.","t":{"ru":"разочарованный, расстроенный","nl":"teleurgesteld","pl":"rozczarowany, zawiedziony","de":"enttäuscht","fr":"déçu","it":"deluso, amareggiato","cs":"zklamaný, rozčarovaný","tr":"hayal kırıklığına uğramış, kırgın, üzgün","es":"decepcionado, desilusionado"}},{"w":"hurt","d":"Feeling emotional pain, sadness, or offense.","t":{"ru":"оби́женный, уязвлённый","nl":"gekwetst, beledigd","pl":"zraniony, obrażony","de":"verletzt, gekränkt","fr":"blessé, froissé","it":"ferito, offeso","cs":"zraněný, uražený","tr":"kırgın, incinmiş","es":"herido, dolido, ofendido"}},{"w":"lonely","d":"Unhappy due to feeling isolated from contact with other people.","t":{"ru":"одино́кий","nl":"eenzaam","pl":"samotny","de":"einsam","fr":"seul, solitaire","it":"solo, solitario","cs":"osamělý, opuštěný","tr":"yalnız, yapayalnız, kimsesiz","es":"solo, solitario"}},{"w":"proud","d":"Feeling happy and satisfied because you or people connected with you have done something good or possess something valuable.","t":{"ru":"го́рдый","nl":"trots, fier","pl":"dumny","de":"stolz","fr":"fier","it":"orgoglioso, fiero","cs":"hrdý, pyšný","tr":"gururlu, gurur duymak","es":"orgulloso"}},{"w":"embarrassed","d":"Feeling ashamed, shy, or uncomfortable because of something that happened or was said.","t":{"ru":"смущённый, неловкий, растерянный","nl":"verlegen, beschaamd, ongemakkelijk","pl":"zawstydzony, zmieszany, niezręczny","de":"verlegen, peinlich berührt, unangenehm","fr":"gêné, embarrassé","it":"imbarazzato, a disagio, impacciato","cs":"v rozpacích, trapně, zahanbený","tr":"utanmış, mahcup, rahatsız","es":"avergonzado, incómodo, apenado"}},{"w":"ashamed","d":"Feeling shame or guilt.","t":{"ru":"сты́дно, присты́женный, со́вестно","nl":"beschaamd, zich schamen","pl":"zawstydzony, skonsternowany, pełen wstydu","de":"beschämt, sich schämen","fr":"honteux, avoir honte, confus","it":"vergognarsi, vergognoso","cs":"zahanbený, stydící se","tr":"utanmış, mahcup, utanç duyan","es":"avergonzado, abochornado, apenado"}},{"w":"confused","d":"Unable to think clearly or understand what is happening or what is being said.","t":{"ru":"растерянный, сбитый с толку, запутанный","nl":"verward, in de war","pl":"zmieszany, zakłopotany, zdezorientowany","de":"verwirrt, durcheinander, konfus","fr":"perdu, désorienté, embarrassé","it":"confuso, disorientato","cs":"zmatený, rozpačitý","tr":"kafası karışmış, şaşkın","es":"confundido, desconcertado"}},{"w":"bored","d":"Feeling tired, unhappy, or restless because one has lost interest or has nothing to do.","t":{"ru":"скучающий, скучно","nl":"verveeld","pl":"znudzony, nudzić się","de":"gelangweilt","fr":"ennuyé","it":"annoiato, scocciato","cs":"znuděný, nudit se","tr":"sıkılmış, sıkılan","es":"aburrido"}},{"w":"jealous","d":"Feeling angry or unhappy because you suspect a person you love is interested in someone else.","t":{"ru":"ревнивый, ревнующий","nl":"jaloers","pl":"zazdrosny","de":"eifersüchtig","fr":"jaloux, jalouse","it":"geloso, gelosa","cs":"žárlivý","tr":"kıskanç","es":"celoso, encelado"}},{"w":"curious","d":"Eager to learn or know something; tending to ask questions and investigate.","t":{"ru":"любопытный, любознательный, пытливый","nl":"nieuwsgierig","pl":"ciekawy, dociekliwy, ciekawski","de":"neugierig, wissbegierig","fr":"curieux, curieux","it":"curioso","cs":"zvědavý, bádavý","tr":"meraklı","es":"curioso, inquieto"}},{"w":"grateful","d":"Feeling or showing thanks because someone has done something kind for you or has done as you asked.","t":{"ru":"благодарный, признательный","nl":"dankbaar, erkentelijk","pl":"wdzięczny","de":"dankbar","fr":"reconnaissant","it":"grato, riconoscente","cs":"vděčný","tr":"minnettar, müteşekkir","es":"agradecido"}},{"w":"indifferent","d":"Having no interest or concern; apathetic.","t":{"ru":"равнодушный, безразличный","nl":"onverschillig","pl":"obojętny","de":"gleichgültig, teilnahmslos","fr":"indifférent, insensible","it":"indifferente, apatico","cs":"lhostejný, netečný","tr":"kayıtsız, ilgisiz, umursamaz","es":"indiferente, apático"}},{"w":"feel","d":"To experience an emotion or physical sensation.","t":{"ru":"чу́вствовать, ощуща́ть","nl":"voelen, zich voelen","pl":"czuć się, czuć, odczuwać","de":"sich fühlen, spüren, fühlen","fr":"se sentir, sentir, ressentir","it":"sentirsi, sentire, provare","cs":"cítit se, cítit","tr":"hissetmek, duymak","es":"sentirse, sentir"}},{"w":"love","d":"To have a strong affection for someone or something.","t":{"ru":"любить, обожать","nl":"houden van, liefhebben, beminnen","pl":"kochać, miłować","de":"lieben, lieb haben, gern haben","fr":"aimer, adorer","it":"amare, volere bene","cs":"milovat, mít rád","tr":"sevmek","es":"amar, querer"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"like","d":"To enjoy, be pleased by, or be in favor of something.","t":{"ru":"нравиться, любить","nl":"leuk vinden, houden van, graag hebben","pl":"lubić, podobać się","de":"mögen, gern haben, gefallen","fr":"aimer, bien aimer, plaire","it":"piacere, gradire, amare","cs":"mít rád, líbit se","tr":"sevmek, hoşlanmak, beğenmek","es":"gustar, disfrutar, amar"}},{"w":"enjoy","d":"To receive pleasure or satisfaction from something.","t":{"ru":"наслаждаться, получать удовольствие","nl":"genieten van, leuk vinden","pl":"cieszyć się, lubić, bawić się dobrze","de":"genießen, sich erfreuen an, Spaß haben an","fr":"aimer, apprécier, profiter de, prendre plaisir à","it":"godere, divertirsi, piacere","cs":"užívat si, mít rád, bavit se, těšit se z","tr":"zevk almak, hoşlanmak, eğlenmek, tadını çıkarmak","es":"disfrutar, gozar, pasarlo bien"}},{"w":"hate","d":"To dislike someone or something intensely.","t":{"ru":"ненавидеть, не выносить","nl":"haten, een hekel hebben aan","pl":"nienawidzić, nie znosić","de":"hassen, nicht ausstehen können","fr":"détester, haïr","it":"odiare, non sopportare","cs":"nenávidět, nesnášet","tr":"nefret etmek, tiksinmek, iğrenmek","es":"odiar, detestar"}},{"w":"fear","d":"To be scared of someone or something; to expect something bad with alarm.","t":{"ru":"бояться, опасаться, страшиться","nl":"vrezen, bang zijn voor","pl":"bać się, lękać się, obawiać się","de":"fürchten, Angst haben vor","fr":"craindre, avoir peur de","it":"temere, aver paura di","cs":"bát se, obávat se","tr":"korkmak, endişelenmek, çekinmek","es":"temer, tener miedo de"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"worry","d":"To feel anxious or troubled about actual or potential problems","t":{"ru":"беспокоиться, волноваться, тревожиться, переживать","nl":"zich zorgen maken, bezorgd zijn","pl":"martwić się, przejmować się, niepokoić się","de":"sich Sorgen machen, beunruhigt sein","fr":"s'inquiéter, se faire du souci, être préoccupé","it":"preoccuparsi, essere in ansia","cs":"dělat si starosti, trápit se, obávat se","tr":"endişelenmek, kaygılanmak, dert etmek","es":"preocuparse, inquietarse, afligirse"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"hope","d":"To want something to happen or be true, usually with some expectation that it might.","t":{"ru":"наде́яться","nl":"hopen","pl":"mieć nadzieję","de":"hoffen","fr":"espérer","it":"sperare","cs":"doufat","tr":"ummak, umut etmek, ümit etmek","es":"esperar, desear"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"miss","d":"To feel sad or regretful because a person, place, or thing is not present.","t":{"ru":"скучать, тосковать","nl":"missen","pl":"tęsknić, brakować","de":"vermissen, sich sehnen nach","fr":"manquer, regretter, languir","it":"mancare, sentire la mancanza di","cs":"stýskat se, postrádat, chybět","tr":"özlemek, eksikliğini hissetmek","es":"extrañar, echar de menos, añorar, hacer falta"}},{"w":"envy","d":"To wish that you had something that another person has.","t":{"ru":"завидовать","nl":"benijden","pl":"zazdrościć","de":"beneiden","fr":"envier, convoiter","it":"invidiare","cs":"závidět","tr":"kıskanmak, imrenmek","es":"envidiar, codiciar"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"regret","d":"To feel sad, repentant, or disappointed over something that has happened or been done, especially a mistake or missed opportunity.","t":{"ru":"сожалеть, жалеть, раскаиваться","nl":"spijt hebben van, betreuren","pl":"żałować, odczuwać skruchę","de":"bereuen, bedauern","fr":"regretter, avoir des regrets","it":"rimpiangere, rammaricarsi, pentirsi","cs":"litovat, želet","tr":"pişman olmak, hayıflanmak","es":"lamentar, arrepentirse de"}},{"w":"admire","d":"To respect and approve of someone or their behavior; to hold in high esteem.","t":{"ru":"восхищаться, восторгаться","nl":"bewonderen, respecteren, opkijken tegen","pl":"podziwiać, szanować","de":"bewundern, verehren, hochschätzen","fr":"admirer, estimer","it":"ammirare, stimare","cs":"obdivovat, uznávat","tr":"hayran olmak, takdir etmek","es":"admirar"}},{"w":"forgive","d":"To stop feeling angry or resentful toward someone for an offense, flaw, or mistake.","t":{"ru":"прощать, простить, извинять","nl":"vergeven","pl":"przebaczać, przebaczyć","de":"verzeihen, vergeben","fr":"pardonner","it":"perdonare","cs":"odpustit, odpouštět","tr":"affetmek, bağışlamak","es":"perdonar, disculpar"}},{"w":"care","d":"To feel concern or interest; to attach importance to something.","t":{"ru":"волноваться, беспокоиться, быть небезразличным","nl":"geven om, schelen, zich bekommeren om","pl":"obchodzić, dbać, przejmować się","de":"sich sorgen, sich kümmern, wichtig sein","fr":"se soucier, s'intéresser, importer","it":"importare, interessarsi, preoccuparsi","cs":"záležet, starat se, zajímat se","tr":"umursamak, önemsemek, umrunda olmak","es":"importar, interesar, preocuparse"}},{"w":"comfort","d":"To make someone feel less unhappy, worried, or upset.","t":{"ru":"утешать, успокаивать","nl":"troosten, geruststellen","pl":"pocieszać, pocieszyć","de":"trösten, beruhigen","fr":"consoler, réconforter","it":"confortare, consolare","cs":"utěšit, uklidnit, konejšit","tr":"teselli etmek, rahatlatmak, ferahlatmak","es":"consolar, confortar"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"annoy","d":"To make someone slightly angry, impatient, or irritated, especially by repeated actions.","t":{"ru":"раздражать, надоедать, досаждать, беспокоить","nl":"ergeren, vervelen, irriteren","pl":"irytować, denerwować, dokuczać, przeszkadzać","de":"ärgern, nerven, stören","fr":"agacer, énerver, embêter, déranger","it":"infastidire, irritare, seccare, disturbare","cs":"obtěžovat, rušit, rozčilovat, otravovat","tr":"rahatsız etmek, kızdırmak, sinirini bozmak, bıktırmak","es":"molestar, irritar, fastidiar, crispar"}},{"w":"upset","d":"To make a person angry, distressed, or unhappy.","t":{"ru":"расстраивать, огорчать, сердить","nl":"overstuur maken, verontrusten, van zijn stuk brengen","pl":"martwić, niepokoić, irytować","de":"ärgern, aufregen","fr":"bouleverser, énerver","it":"turbare, innervosire, angosciare","cs":"rozrušit, rozladit, naštvat","tr":"üzmek, kızdırmak, moralini bozmak","es":"disgustar, enfadar, perturbar"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"surprise","d":"To cause someone to feel amazed or shocked by doing something unexpected.","t":{"ru":"удивлять, поражать","nl":"verbazen, verrassen","pl":"dziwić, zaskakiwać","de":"überraschen, verblüffen","fr":"surprendre, étonner","it":"sorprendere, stupire","cs":"překvapit, udivit","tr":"şaşırtmak","es":"sorprender"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"relax","d":"To rest and become calm, often to stop worrying or working.","t":{"ru":"расслабляться, отдыхать","nl":"ontspannen, tot rust komen","pl":"odprężać się, zrelaksować się, odpoczywać","de":"sich entspannen, relaxen","fr":"se détendre, se relaxer, se reposer","it":"rilassarsi, riposarsi","cs":"odpočívat, relaxovat, uvolnit se","tr":"dinlenmek, rahatlamak, gevşemek","es":"relajarse, descansar"}},{"w":"smile","d":"To form one's features into a pleased, friendly, or amused expression, typically with the corners of the mouth turned up.","t":{"ru":"улыбаться, улыбнуться","nl":"glimlachen, lachen","pl":"uśmiechać się, uśmiechnąć się","de":"lächeln, schmunzeln","fr":"sourire","it":"sorridere","cs":"usmívat se, usmát se","tr":"gülümsemek, tebessüm etmek","es":"sonreír"},"c":{"ru":"глагол","nl":"werkwoord","pl":"czasownik","de":"Verb","fr":"verbe","it":"verbo","cs":"sloveso","tr":"fiil","es":"verbo"}},{"w":"laugh","d":"To make sounds and movements of the face that show happiness or amusement.","t":{"ru":"смеяться, хохотать, рассмеяться","nl":"lachen","pl":"śmiać się, rechotać","de":"lachen, kichern","fr":"rire, rigoler","it":"ridere","cs":"smát se, rozesmát se, chechtat se","tr":"gülmek, kahkaha atmak","es":"reír, reírse"}},{"w":"cry","d":"To shed tears, especially as an expression of sadness, pain, or anger.","t":{"ru":"плакать, рыдать","nl":"huilen, wenen","pl":"płakać, szlochać","de":"weinen","fr":"pleurer","it":"piangere","cs":"plakat, brečet, vlykat","tr":"ağlamak, hıçkıra hıçkıra ağlamak","es":"llorar"}}]