[{"w":"football","d":"Association football, also called soccer: a game in which two teams each contend to get a round ball into the other team's goal primarily by kicking the ball.","t":{"ru":"футбол","nl":"voetbal","pl":"piłka nożna, futbol","de":"Fußball, Fussball","fr":"football, foot, soccer","it":"calcio","cs":"fotbal, kopaná","tr":"futbol, ayak topu","es":"fútbol, balompié"}},{"w":"soccer","d":"A game played by two teams of eleven players with a round ball that may not be touched with the hands or arms during play except by the goalkeepers.","t":{"ru":"футбол, соккер","nl":"voetbal","pl":"piłka nożna, futbol, noga","de":"Fußball","fr":"football, soccer","it":"calcio","cs":"fotbal, kopaná","tr":"futbol, ayak topu","es":"fútbol, futbol, balompié"}},{"w":"match","d":"A competitive sporting event or game between two people or teams.","t":{"ru":"матч, состязание, поединок","nl":"wedstrijd, match","pl":"mecz, zawody","de":"Spiel, Match, Wettkampf","fr":"match, partie","it":"partita, incontro, gara","cs":"zápas, utkání","tr":"maç, müsabaka","es":"partido, encuentro"}},{"w":"league","d":"An organization of sports teams which play against one another for a championship.","t":{"ru":"лига","nl":"competitie, liga, klasse","pl":"liga","de":"Liga, Spielklasse","fr":"ligue","it":"lega, campionato","cs":"liga","tr":"lig","es":"liga"}},{"w":"cup","d":"A sports competition or tournament for which a trophy is awarded.","t":{"ru":"кубок","nl":"bekertoernooi, cup","pl":"puchar","de":"Cup, Pokal","fr":"coupe","it":"coppa","cs":"pohár","tr":"kupa","es":"copa"}},{"w":"tournament","d":"A series of games played competitively to determine a single winning team or individual.","t":{"ru":"турнир, состязание","nl":"toernooi, tornooi","pl":"turniej, zawody","de":"Turnier, Wettkampf","fr":"tournoi, compétition","it":"torneo, gara","cs":"turnaj","tr":"turnuva","es":"torneo, campeonato"}},{"w":"championship","d":"A competition to determine a champion, especially the final of a series of competitions.","t":{"ru":"чемпиона́т, пе́рвенство","nl":"kampioenschap","pl":"mistrzostwa, turniej","de":"Meisterschaft, Titelkampf","fr":"championnat","it":"campionato, torneo","cs":"mistrovství, šampionát","tr":"şampiyona, turnuva","es":"campeonato"}},{"w":"champion","d":"A person or team that has won a competition or contest.","t":{"ru":"чемпион, победитель","nl":"kampioen, kampioene","pl":"mistrz, mistrzyni, czempion","de":"Meister, Sieger, Gewinner","fr":"champion, championne, vainqueur","it":"campione, campionessa","cs":"šampión, mistr, přeborník","tr":"şampiyon, birinci","es":"campeón, campeona"}},{"w":"title","d":"The position of being the winner in a sports competition or championship.","t":{"ru":"ти́тул, зва́ние","nl":"titel, kampioenschap","pl":"tytuł, mistrzostwo","de":"Titel, Meistertitel","fr":"titre","it":"titolo","cs":"titul","tr":"unvan, şampiyonluk","es":"título, campeonato"}},{"w":"trophy","d":"An object, such as a cup, shield, or statue, given to the winner of a competition or to mark a great achievement.","t":{"ru":"трофей, кубок, приз","nl":"trofee, beker, prijs","pl":"trofeum, puchar, nagroda","de":"Trophäe, Pokal, Preis","fr":"trophée, coupe, prix","it":"trofeo, coppa, premio","cs":"trofej, pohár, cena","tr":"kupa, ödül, trofe","es":"trofeo, copa"}},{"w":"team","d":"A group of people who work together or play a sport together as a unit.","t":{"ru":"команда, коллектив, бригада","nl":"team, ploeg","pl":"drużyna, zespół, ekipa","de":"Team, Mannschaft, Arbeitsgruppe","fr":"équipe","it":"squadra, team, équipe","cs":"tým, mužstvo, kolektiv","tr":"takım, ekip, grup","es":"equipo, cuadrilla"}},{"w":"squad","d":"A group of players in a sports team from which the starting lineup and substitutes are chosen for a match or tournament.","t":{"ru":"состав, команда","nl":"selectie, team, kader","pl":"kadra, skład, drużyna","de":"Kader, Mannschaft, Aufgebot","fr":"effectif, groupe, équipe","it":"squadra, rosa, organico","cs":"kádr, tým, sestava","tr":"kadro, takım","es":"plantilla, escuadra, plantel"}},{"w":"player","d":"A person who takes part in a sport or game.","t":{"ru":"игрок","nl":"speler, speelster","pl":"gracz, zawodnik, graczka","de":"Spieler, Spielerin","fr":"joueur, joueuse","it":"giocatore","cs":"hráč, hráčka","tr":"oyuncu, sporcu","es":"jugador, jugadora"}},{"w":"goalkeeper","d":"A designated player that attempts to prevent the opposing team from scoring by protecting a goal.","t":{"ru":"вратарь, голкипер","nl":"doelman, keeper, doelverdediger","pl":"bramkarz, goalkeeper","de":"Torwart, Torhüter, Torwartin","fr":"gardien de but, gardienne de but, gardien","it":"portiere","cs":"brankář, gólman, brankářka","tr":"kaleci, gole bekçi","es":"portero, arquero, guardameta"}},{"w":"keeper","d":"A player whose role is to stop the ball from entering the goal or hitting the wicket in sports like soccer, hockey, or cricket.","t":{"ru":"вратарь, голкипер","nl":"keeper, doelman","pl":"bramkarz, golkiper","de":"Torhüter, Torwart, Keeper","fr":"gardien, gardienne, gardien de but","it":"portiere","cs":"brankář, gólman","tr":"kaleci, file bekçisi","es":"portero, guardameta, arquero"}},{"w":"defender","d":"A player in sports whose main task is to prevent the other team from scoring.","t":{"ru":"защитник","nl":"verdediger, verdedigster","pl":"obrońca","de":"Verteidiger, Verteidigerin, Abwehrspieler","fr":"défenseur, défenseuse","it":"difensore","cs":"obránce, obránkyně, bek","tr":"savunma oyuncusu, defans, bek","es":"defensor, defensora, defensa"}},{"w":"midfielder","d":"A player in sports such as football or hockey who plays in the central part of the field, positioned between the defenders and the attackers.","t":{"ru":"полузащитник, хавбек","nl":"middenvelder","pl":"pomocnik","de":"Mittelfeldspieler, Mittelfeldspielerin","fr":"milieu de terrain, milieu","it":"centrocampista","cs":"záložník, středopolař","tr":"orta saha oyuncusu, orta saha","es":"centrocampista, mediocampista, volante"}},{"w":"striker","d":"A player in football (soccer) whose primary role is to attack and score goals.","t":{"ru":"нападающий, форвард","nl":"spits, aanvaller","pl":"napastnik, snajper","de":"Stürmer, Angreifer","fr":"attaquant, buteur, avant-centre","it":"attaccante, centravanti, punta","cs":"útočník, hrotový útočník","tr":"forvet, santrfor, golcü","es":"delantero, atacante, ariete"}},{"w":"forward","d":"A player in a team sport (such as soccer, rugby, or basketball) positioned near the opponent's goal to score points.","t":{"ru":"напада́ющий, фо́рвард","nl":"aanvaller, forward, spits","pl":"napastnik, forward","de":"Stürmer, Stürmerin","fr":"attaquant, avant","it":"attaccante, avanti","cs":"útočník","tr":"forvet, hücum oyuncusu","es":"delantero, atacante"}},{"w":"captain","d":"One of the athletes on a sports team who is designated to make decisions and speak for the team.","t":{"ru":"капитан","nl":"aanvoerder, kapitein","pl":"kapitan","de":"Kapitän, Mannschaftskapitän","fr":"capitaine","it":"capitano","cs":"kapitán","tr":"kaptan","es":"capitán"}},{"w":"referee","d":"An official who controls a sports game and ensures the rules are followed.","t":{"ru":"судья, арбитр, рефери","nl":"scheidsrechter, arbiter","pl":"sędzia, arbiter, refeeri","de":"Schiedsrichter, Schiedsrichterin","fr":"arbitre","it":"arbitro, direttore di gara","cs":"rozhodčí, sudí, arbitr","tr":"hakem","es":"árbitro, réferi"}},{"w":"linesman","d":"An official who assists the referee in sports like football or rugby, primarily by indicating when the ball has gone out of play.","t":{"ru":"боковой судья, лайнсмен, помощник судьи","nl":"grensrechter, assistent-scheidsrechter, linesman","pl":"sędzia liniowy, asystent sędziego, liniowy","de":"Linienrichter, Schiedsrichterassistent","fr":"juge de touche, arbitre assistant","it":"guardalinee, assistente dell'arbitro","cs":"pomezní rozhodčí, asistent rozhodčího, pomezní","tr":"yan hakem, yardımcı hakem, çizgi hakemi","es":"juez de línea, linier, árbitro asistente"}},{"w":"substitute","d":"A player available to replace another player during a game.","t":{"ru":"запасной, замена","nl":"wisselspeler, invaller, reserve","pl":"rezerwowy, zmiennik","de":"Auswechselspieler, Ersatzspieler, Austauschspieler","fr":"remplaçant, substitut","it":"sostituto, riserva","cs":"náhradník, střídající hráč","tr":"yedek oyuncu, yedek","es":"suplente, sustituto"}},{"w":"pitch","d":"The area of ground marked out for playing a game such as soccer, cricket, or rugby.","t":{"ru":"поле, площадка","nl":"veld, speelveld","pl":"boisko, pole","de":"Spielfeld, Sportplatz, Platz","fr":"terrain, pelouse","it":"campo","cs":"hřiště","tr":"saha, futbol sahası","es":"campo, terreno de juego, cancha"}},{"w":"goal","d":"A point scored in a game as a result of placing the ball or object into the net or scoring area.","t":{"ru":"гол","nl":"doelpunt, goal","pl":"gol, bramka","de":"Tor","fr":"but","it":"gol, rete, goal","cs":"gól, branka","tr":"gol","es":"gol, tanto"}},{"w":"post","d":"One of the upright poles that form the goal in sports like football or rugby.","t":{"ru":"штанга","nl":"doelpaal, paal","pl":"słupek","de":"Pfosten","fr":"poteau","it":"palo","cs":"tyč, tyčka","tr":"kale direği, direk","es":"poste, palo"}},{"w":"net","d":"The goal in sports like soccer or hockey, consisting of a frame covered with mesh.","t":{"ru":"сетка, ворота","nl":"net, doelnet","pl":"siatka, bramka","de":"Netz, Tor","fr":"filet, but","it":"rete, porta","cs":"síť, branka","tr":"ağlar, kale","es":"red, portería, arco"}},{"w":"score","d":"To earn points or goals in a game or sport.","t":{"ru":"забивать, набирать очки","nl":"scoren, doelpunten maken","pl":"zdobyć punkt, strzelić gola, punktować","de":"erzielen, schießen, treffen","fr":"marquer, gagner","it":"segnare, realizzare, fare punto","cs":"skórovat, bodovat, dát gól","tr":"atmak, skor yapmak, sayı yapmak","es":"marcar, anotar, puntuar"}},{"w":"shoot","d":"To fire a weapon or launch a projectile.","t":{"ru":"стрелять, выстрелить","nl":"schieten, afvuren","pl":"strzelać, wystrzelić","de":"schießen, abschießen","fr":"tirer","it":"sparare, scagliare, tirare","cs":"střílet, střelit, vystřelit","tr":"ateş etmek, vurmak, fırlatmak","es":"disparar, tirar"}},{"w":"pass","d":"To throw or kick a ball or puck to a teammate in a sport.","t":{"ru":"пасовать, передавать","nl":"passen, overspelen","pl":"podawać, podać","de":"passen, abgeben, weitergeben","fr":"passer, faire une passe","it":"passare","cs":"přihrát, nahrát, přihrávat","tr":"pas atmak, pas vermek","es":"pasar, dar un pase"}},{"w":"dribble","d":"To move a ball forward in a game by repeatedly kicking or bouncing it.","t":{"ru":"вести мяч, вести","nl":"dribbelen","pl":"kozłować, dryblować","de":"dribbeln","fr":"dribbler","it":"dribblare, fare un dribbling","cs":"driblovat, vést míč","tr":"top sürmek, dripling yapmak","es":"driblar, regatear, gambetear"}},{"w":"header","d":"The act of hitting a ball with the head, especially in soccer.","t":{"ru":"удар головой","nl":"kopbal","pl":"główka, uderzenie głową","de":"Kopfball, Kopfballstoß","fr":"tête, coup de tête","it":"colpo di testa","cs":"hlavička, úder hlavou","tr":"kafa vuruşu, kafa","es":"cabezazo, testarazo"}},{"w":"tackle","d":"To force an opponent to the ground or attempt to take the ball from them in a sport.","t":{"ru":"атаковать, делать подкат, валить","nl":"tackelen, neerhalen","pl":"atakować, powalić, zrobić wślizg","de":"tackeln, grätschen, angreifen","fr":"plaquer, tacler","it":"placcare, intervenire in scivolata, contrastare","cs":"složit, obírat o míč, atakovat","tr":"müdahale etmek, yere yıkmak, topu kapmaya çalışmak","es":"placar, taclear, entrar"}},{"w":"save","d":"To stop a ball or puck from entering the goal in sports.","t":{"ru":"отбить, спасти, поймать","nl":"redden, tegenhouden","pl":"obronić, wybić, odbić","de":"halten, retten","fr":"arrêter, parer, bloquer","it":"parare, salvare","cs":"chytit, krýt, zneškodnit","tr":"kurtarmak","es":"parar, salvar"}},{"w":"defend","d":"To try to prevent the opposing team or player from scoring points in a game.","t":{"ru":"защищать, обороняться","nl":"verdedigen","pl":"bronić, bronić się","de":"verteidigen, Abwehr spielen","fr":"défendre","it":"difendere, difendersi","cs":"bránit, ubránit","tr":"savunmak, savunma yapmak","es":"defender, defenderse"}},{"w":"attack","d":"To apply violent force to someone or something.","t":{"ru":"атаковать, нападать, напасть","nl":"aanvallen","pl":"atakować, zaatakować, napadać","de":"angreifen, attackieren","fr":"attaquer, agresser","it":"attaccare, aggredire, assalire","cs":"zaútočit, napadnout, útočit","tr":"saldırmak, atak yapmak","es":"atacar, agredir"}},{"w":"whistle","d":"A small instrument or device that produces a loud, high-pitched sound when blown.","t":{"ru":"свисток","nl":"fluitje","pl":"gwizdek, piszczałka","de":"Pfeife, Trillerpfeife","fr":"sifflet","it":"fischietto","cs":"píšťalka, píšťala","tr":"düdük","es":"silbato, pito"}},{"w":"cheer","d":"To shout loudly to show support, encouragement, approval, or happiness.","t":{"ru":"болеть, приветствовать, ликовать","nl":"juichen, aanmoedigen, jubelen","pl":"wiwatować, kibicować, dopingować","de":"jubeln, bejubeln, anfeuern","fr":"acclamer, encourager, applaudir","it":"incitare, esultare, fare il tifo","cs":"fandit, jásat, povzbuzovat","tr":"tezahürat yapmak, alkışlamak, desteklemek","es":"vitorear, animar, aclamar"}},{"w":"celebrate","d":"To do something enjoyable or have a party because something good has happened.","t":{"ru":"праздновать, отмечать","nl":"vieren, feestvieren","pl":"świętować, obchodzić, oblać","de":"feiern, feiern gehen","fr":"fêter, faire la fête, célébrer","it":"festeggiare, celebrare","cs":"slavit, oslavit","tr":"kutlamak, kutlama yapmak","es":"celebrar, festejar"}},{"w":"kick-off","d":"The start of a game of football, marked by kicking the ball from the center of the field.","t":{"ru":"начало матча, введение мяча в игру, стартовый удар","nl":"aftrap","pl":"rozpoczęcie meczu, rozpoczęcie spotkania, pierwszy gwizdek","de":"Anstoß, Spielbeginn","fr":"coup d'envoi","it":"calcio d'inizio, fischio d'inizio","cs":"výkop, zahájení zápasu","tr":"başlama vuruşu, santra","es":"saque inicial, pitido inicial, saque de centro"}},{"w":"corner","d":"A corner kick in soccer.","t":{"ru":"угловой, корнер","nl":"corner, hoekschop","pl":"rzut rożny, róg","de":"Ecke, Eckball, Eckstoß","fr":"corner, coup de pied de coin","it":"calcio d'angolo, corner","cs":"roh, rohový kop","tr":"korner, köşe vuruşu","es":"tiro de esquina, saque de esquina, córner"}},{"w":"penalty","d":"A direct free kick or shot at the goal awarded to a team in sports because the opposing team has broken a rule.","t":{"ru":"пенальти, одиннадцатиметровый","nl":"penalty, strafschop","pl":"rzut karny, karny","de":"Elfmeter, Penalty, Strafstoß","fr":"penalty, pénalité, tir au but","it":"rigore, calcio di rigore, penalty","cs":"penalta, pokutový kop","tr":"penaltı","es":"penalti, tiro penal"}},{"w":"offside","d":"An illegal position or play in sports where a player is ahead of the ball, puck, or last defender.","t":{"ru":"офсайд, положение вне игры","nl":"buitenspel","pl":"spalony","de":"Abseits, Abseitsstellung","fr":"hors-jeu","it":"fuorigioco","cs":"ofsajd, postavení mimo hru","tr":"ofsayt","es":"fuera de juego, posición adelantada, offside"}},{"w":"foul","d":"A breach of the rules of a game, especially one involving inappropriate contact with an opposing player.","t":{"ru":"фол","nl":"overtreding, fout","pl":"faul","de":"Foul, Regelverstoß","fr":"faute","it":"fallo","cs":"faul, přestupek","tr":"faul","es":"falta, foul, infracción"}},{"w":"win","d":"To achieve victory in a fight, contest, game, or conflict.","t":{"ru":"побеждать, выигрывать","nl":"winnen, overwinnen","pl":"wygrywać, zwyciężać","de":"gewinnen, siegen","fr":"gagner, l'emporter","it":"vincere","cs":"vyhrát, zvítězit, vítězit","tr":"kazanmak, yenmek","es":"ganar, vencer"}},{"w":"lose","d":"To fail to win a game, competition, argument, or war.","t":{"ru":"проигрывать, проиграть","nl":"verliezen","pl":"przegrać, przegrywać","de":"verlieren, unterliegen","fr":"perdre, s'incliner","it":"perdere","cs":"prohrát, prohrávat","tr":"kaybetmek, yenilmek","es":"perder, fracasar"}},{"w":"draw","d":"The result of a game or contest in which neither side wins; a tie.","t":{"ru":"ничья́","nl":"gelijkspel","pl":"remis","de":"Unentschieden, Remis","fr":"match nul, égalité","it":"pareggio","cs":"remíza","tr":"beraberlik","es":"empate"}},{"w":"defeat","d":"An occasion when someone loses a game, battle, or contest.","t":{"ru":"поражение, проигрыш","nl":"nederlaag, verlies","pl":"porażka, przegrana","de":"Niederlage","fr":"défaite","it":"sconfitta, disfatta","cs":"porážka, prohra","tr":"yenilgi, mağlubiyet, hezimet","es":"derrota"}},{"w":"relegation","d":"The transfer of a sports team to a lower division, typically due to finishing near the bottom of the league table.","t":{"ru":"вылет, понижение в классе","nl":"degradatie","pl":"spadek, degradacja","de":"Abstieg","fr":"relégation, descente","it":"retrocessione","cs":"sestup, pád","tr":"küme düşme, ligden düşme","es":"descenso, relegación"}}]