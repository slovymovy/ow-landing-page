---
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import MobileDownloadBar from '../MobileDownloadBar.astro';
import StoreButtons from '../StoreButtons.astro';
import WordListSteps from '../WordListSteps.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeCopy } from '../../data/copy';
import { absoluteUrl, languages, localizePath, type LanguageSlug, type LocaleCode } from '../../data/site';
import { hubCards, hubFaq, hubPath, hubStepBlock, wlCopy } from '../../data/wordLists';

interface Props {
  locale: LocaleCode;
  language?: LanguageSlug;
}

const { locale, language = 'english' } = Astro.props;
const c = wlCopy(locale, language);
const home = homeCopy[locale];
const cards = hubCards(locale, language);
const faqItems = hubFaq(locale, language);
const steps = hubStepBlock(locale, language);

const langInfo = languages[language];
const langLabel = langInfo.displayName[locale];
const learnHref = localizePath(locale, `/learn/${langInfo.slug}`);
const path = `/word-lists/${langInfo.slug}`;

const faq = faqItems.map((f) => ({ question: f.q, answer: f.a }));

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'OpenWords', item: absoluteUrl(localizePath(locale, '/')) },
      { '@type': 'ListItem', position: 2, name: langLabel, item: absoluteUrl(learnHref) },
      { '@type': 'ListItem', position: 3, name: home.ui.navWordLists, item: absoluteUrl(hubPath(locale, language)) }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: c.siblingsLabel,
    itemListElement: cards.map((card, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: card.name,
      url: absoluteUrl(card.href)
    }))
  }
];
---
<BaseLayout
  title={c.hubTitle}
  description={c.hubDescription}
  locale={locale}
  path={path}
  faq={faq}
  structuredData={structuredData}
>
  <Header locale={locale} activeLanguage={language} section="lists" path={path} />

  <main>
    <!-- HERO (centered) -->
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="container">
        <div class="hero__inner">
          <nav class="hero__breadcrumb" aria-label="Breadcrumb">
            <a href={localizePath(locale, '/')}>OpenWords</a> / <a href={learnHref}>{langLabel}</a> / <span>{home.ui.navWordLists}</span>
          </nav>
          <h1 class="hero__h1" set:html={c.hubH1Html}></h1>
          <p class="hero__sub">{c.hubSub}</p>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- ALL LISTS GRID -->
    <section class="hublists">
      <div class="container">
        <div class="topics__grid">
          {cards.map((card) => (
            <a class="topic-card" href={card.href}>
              <div class="topic-card__top">
                <span class="topic-card__name">{card.name}</span>
                <span class="topic-card__arrow" aria-hidden="true">→</span>
              </div>
              <p class="topic-card__desc">{card.desc}</p>
              <span class="topic-card__count">{card.count}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- HOW IT WORKS -->
    <WordListSteps
      eyebrow={steps.eyebrow}
      h2={steps.h2}
      sub={steps.sub}
      steps={steps.steps}
      note={steps.note}
      locale={locale}
    />

    <div class="divider"></div>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">
        <div class="section-head">
          <div class="section-eyebrow">FAQ</div>
          <h2 class="section-h2">{home.faqTitle}</h2>
        </div>
        <div class="faq__list">
          {faqItems.map((item, i) => (
            <details class="faq-item" open={item.open || undefined}>
              <summary>
                {item.q}
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- FINAL CTA -->
    <section class="cta" id="download">
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="container">
        <div class="cta__inner">
          <div class="cta__mascot">
            <img src="/svg_final_otter_favourites.dark.optimized.svg" alt={home.ui.savedMascotAlt} width="280" />
          </div>
          <div class="cta__body">
            <div class="cta__eyebrow">{home.eyebrow}</div>
            <h2 class="cta__h2">{home.finalCta}</h2>
            <p class="cta__sub">{home.ctaSub}</p>
            <div class="cta__btns"><StoreButtons locale={locale} centered /></div>
            <p class="cta__note">{home.heroTagline}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <MobileDownloadBar locale={locale} />

  <Footer locale={locale} />
</BaseLayout>

<style>
  /* ── HERO (centered) ── */
  .hero {
    padding: 104px 0 40px;
    position: relative;
    overflow: hidden;
    background: var(--night-900);
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% -10%, rgba(197,163,103,.08), transparent 60%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .hero__breadcrumb { font-size: .8125rem; color: #868ca6; margin-bottom: 16px; }
  .hero__breadcrumb a { color: #868ca6; transition: color .18s; }
  .hero__breadcrumb a:hover { color: #9499B0; }
  .hero__h1 {
    font-family: Lora, Georgia, serif;
    font-size: clamp(2.125rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -.02em;
    color: #E2E4ED;
    margin-bottom: 20px;
  }
  .hero__h1 :global(em) { font-style: normal; color: #C5A367; }
  .hero__sub {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.78;
    color: #9499B0;
    max-width: 620px;
    margin: 0 auto;
  }

  /* ── ALL LISTS GRID ── */
  .hublists { padding: 48px 0 24px; background: var(--night-900); }
  .topics__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 600px) { .topics__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 920px) { .topics__grid { grid-template-columns: repeat(3, 1fr); } }
  .topic-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 22px 20px;
    background: #1C1F2A;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 20px;
    transition: border-color .2s, transform .2s;
  }
  .topic-card:hover { border-color: rgba(197,163,103,.20); transform: translateY(-2px); }
  .topic-card__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .topic-card__name {
    font-family: Lora, Georgia, serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #E2E4ED;
  }
  .topic-card__arrow { color: #555a70; transition: color .2s, transform .2s; }
  .topic-card:hover .topic-card__arrow { color: #C5A367; transform: translateX(3px); }
  .topic-card__desc { font-size: .875rem; line-height: 1.55; color: #9499B0; margin: 0; }
  .topic-card__count {
    text-transform: uppercase;
    font-size: .75rem;
    letter-spacing: .05em;
    color: #555a70;
  }

  /* ── FAQ ── */
  .faq-section { padding: 88px 0; background: var(--night-900); }
  .section-head { text-align: center; margin-bottom: 44px; }
  .section-eyebrow {
    font-size: .6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: #C5A367;
    margin-bottom: 10px;
  }
  .section-h2 {
    font-family: Lora, Georgia, serif;
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.18;
    color: #E2E4ED;
    letter-spacing: -.01em;
  }
  .faq__list {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .faq-item {
    background: #1C1F2A;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color .2s;
  }
  .faq-item[open] { border-color: rgba(197,163,103,.20); }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    font-size: .9375rem;
    font-weight: 600;
    color: #E2E4ED;
    cursor: pointer;
    list-style: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: #C5A367;
    transition: transform .25s, background .2s;
  }
  .faq-item[open] .faq-icon { transform: rotate(45deg); background: rgba(197,163,103,.10); }
  .faq-answer { padding: 0 24px 20px; font-size: .9375rem; line-height: 1.77; color: #9499B0; }

  /* ── FINAL CTA ── */
  .cta { padding: 96px 0; background: #0f1118; position: relative; overflow: hidden; }
  .cta__glow {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 400px;
    background: radial-gradient(ellipse at 50% 0%, rgba(197,163,103,.07) 0%, transparent 60%);
    pointer-events: none;
  }
  .cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .cta__inner { grid-template-columns: 280px 1fr; gap: 80px; }
  }
  .cta__mascot { display: flex; justify-content: center; }
  .cta__mascot img {
    width: clamp(180px, 48vw, 280px);
    animation: float-mascot 7s ease-in-out 1.5s infinite;
    filter: drop-shadow(0 12px 40px rgba(197,163,103,.18));
  }
  @keyframes float-mascot {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta__mascot img { animation: none; }
  }
  .cta__body { text-align: center; }
  @media (min-width: 860px) { .cta__body { text-align: left; } }
  .cta__eyebrow {
    font-size: .6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: #C5A367;
    margin-bottom: 10px;
  }
  .cta__h2 {
    font-family: Lora, Georgia, serif;
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -.01em;
    color: #E2E4ED;
    margin-bottom: 16px;
  }
  .cta__sub { font-size: 1rem; color: #9499B0; line-height: 1.75; margin-bottom: 28px; }
  .cta__btns { display: flex; justify-content: center; }
  @media (min-width: 860px) { .cta__btns { justify-content: flex-start; } }
  .cta__note { font-size: .8125rem; color: #868ca6; margin-top: 14px; }

  /* ── DIVIDER ── */
  .divider { height: 1px; background: linear-gradient(90deg, transparent, rgba(197,163,103,.14), transparent); }

  /* ── MOBILE SPACING ── */
  @media (max-width: 640px) {
    .hero { padding: 84px 0 26px; }
    .hublists { padding: 26px 0 6px; }
    .faq-section { padding: 48px 0; }
    .cta { padding: 56px 0; }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 16), { passive: true });
    nav.classList.toggle('scrolled', window.scrollY > 16);
  }
</script>
