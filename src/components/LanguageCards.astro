---
import { homeCopy } from '../data/copy';
import { hasLearnPage, languageInfo, localizePath, supportedLanguageSlugs, type LocaleCode, type SupportedLanguageSlug } from '../data/site';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const copy = homeCopy[locale];

// Czech "Učit se" needs the accusative case. `localName` holds the genitive
// form the learn pages rely on (e.g. "slovní zásoba angličtiny"), so the card
// CTA supplies its own accusative form just for Czech.
type CardSlug = SupportedLanguageSlug;
const csAccusative: Record<CardSlug, string> = {
  english: 'angličtinu',
  dutch: 'nizozemštinu',
  polish: 'polštinu',
  russian: 'ruštinu',
  german: 'němčinu'
};
// French needs a definite article after "Apprendre" ("Apprendre l'anglais",
// "Apprendre le néerlandais"), which localName (bare name) doesn't include.
const frArticle: Record<CardSlug, string> = {
  english: 'l\'anglais',
  dutch: 'le néerlandais',
  polish: 'le polonais',
  russian: 'le russe',
  german: 'l\'allemand'
};
const info = languageInfo;
const ctaName = (slug: CardSlug) =>
  locale === 'cs' ? csAccusative[slug]
  : locale === 'fr' ? frArticle[slug]
  : info(slug).localName[locale];

// Turkish is verb-final: the object comes before the verb ("İngilizce Öğren",
// not "Öğren İngilizce"), so the CTA flips word order for Turkish.
const ctaText = (slug: CardSlug) =>
  locale === 'tr'
    ? `${ctaName(slug)} ${copy.learnVerb}`
    : `${copy.learnVerb} ${ctaName(slug)}`;

// Learn-page languages link to their /learn page. App-only languages (German,
// no website page yet) link to the download section on the same page instead.
const cards = supportedLanguageSlugs.map((slug) => ({
  slug,
  href: hasLearnPage(slug) ? localizePath(locale, `/learn/${slug}`) : '#download'
}));
---
<div class="lang-grid">
  {cards.map(({ slug, href }) => (
    <a class="lang-card" href={href}>
      <div class="lang-card__flag" aria-hidden="true">{info(slug).flag}</div>
      <div class="lang-card__name">{info(slug).displayName[locale]}</div>
      <div class="lang-card__cta">
        {ctaText(slug)}
        <span aria-hidden="true">→</span>
      </div>
    </a>
  ))}
</div>

<style>
  /* Compact 2-column grid on phones — avoids tall stacked cards / dead space.
     With an odd card count the last card spans the row so nothing dangles. */
  .lang-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
  }

  .lang-card:last-child:nth-child(odd) { grid-column: 1 / -1; }

  @media (min-width: 960px) {
    .lang-grid { grid-template-columns: repeat(5, 1fr); }
    .lang-card:last-child:nth-child(odd) { grid-column: auto; }
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 14px;
    background: #1C1F2A;
    border: 1px solid rgba(255, 255, 255, .07);
    border-radius: 16px;
    text-decoration: none;
    transition: border-color .2s, transform .2s, box-shadow .2s;
  }

  @media (min-width: 560px) {
    .lang-card { gap: 8px; padding: 22px 20px 18px; border-radius: 18px; }
  }

  @media (min-width: 960px) {
    .lang-card { gap: 10px; padding: 28px 24px 24px; border-radius: 20px; }
  }

  .lang-card:hover {
    border-color: rgba(197, 163, 103, .4);
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, .3);
  }

  .lang-card__flag { font-size: 1.625rem; line-height: 1; }

  @media (min-width: 560px) { .lang-card__flag { font-size: 2rem; } }

  .lang-card__name {
    font-family: Lora, Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    color: #E2E4ED;
  }

  @media (min-width: 560px) { .lang-card__name { font-size: 1.125rem; } }

  .lang-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: .8125rem;
    font-weight: 600;
    color: #C5A367;
    margin-top: 2px;
  }

  @media (min-width: 560px) { .lang-card__cta { font-size: .875rem; margin-top: 4px; } }
</style>
